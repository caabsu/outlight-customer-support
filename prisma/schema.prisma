generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id               String         @id @default(uuid())
  name             String
  gmailAccountEmail String        @unique
  googleClientId   String
  googleClientSecret String
  createdAt        DateTime       @default(now())
  customers        Customer[]
  conversations    Conversation[]
  oauthTokens      OAuthToken[]
  products         Product[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          String         @default("ADMIN")
  createdAt     DateTime       @default(now())
  conversations Conversation[] @relation("UserConversations")
}

model Customer {
  id            String         @id @default(uuid())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String
  primaryEmail  String
  name          String?
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime?
  conversations Conversation[]

  @@unique([workspaceId, primaryEmail])
}

model Conversation {
  id                    String         @id @default(uuid())
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId           String
  gmailThreadId         String
  subject               String?
  customer              Customer       @relation(fields: [customerId], references: [id])
  customerId            String
  status                String         @default("open")
  assignedUser          User?          @relation("UserConversations", fields: [assignedUserId], references: [id])
  assignedUserId        String?
  firstMessageAt        DateTime?
  lastMessageAt         DateTime?
  lastHistoryId         BigInt?
  unreadAgent           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  starred               Boolean        @default(false)
  archived              Boolean        @default(false)

  // OLD TAGGING SYSTEM (deprecated, kept for migration only)
  tags                  String[]       @default([])

  // NEW TAGGING SYSTEM (v2)
  needsReply            Boolean        @default(false)         // System-managed: true if last message was inbound
  lastMessageDirection  String?                                // "inbound" | "outbound" - tracks last message direction
  userTags              String[]       @default([])            // User-managed: admin, non-customer-support, custom tags

  aiSummary             String?
  aiSummaryGeneratedAt  DateTime?
  messages              Message[]
  draftResponse         DraftResponse?

  @@unique([workspaceId, gmailThreadId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  gmailMessageId String       @unique
  direction      String
  fromEmail      String
  toEmails       Json         @default("[]")
  ccEmails       Json         @default("[]")
  sentAt         DateTime
  bodyHtml       String?
  bodyText       String?
  attachments    Json         @default("[]")
  replyToEmail   String?
  isRead         Boolean      @default(true)
}

model OAuthToken {
  id           String    @id @default(uuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String    @unique
  provider     String
  accountEmail String
  accessToken  String
  refreshToken String
  expiry       DateTime
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  tags      String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftResponse {
  id                 String       @id @default(uuid())
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId     String       @unique
  internalReasoning  String?
  tags               String[]     @default([])
  category           String?
  reasoning          String?
  shouldDraft        Boolean      @default(false)
  draft              String?
  actionSteps        Json?
  orderInfo          Json?
  customInstructions String?      // Custom instructions used when generating this draft
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model StandaloneDraft {
  id                 String    @id @default(uuid())

  // Input fields
  subject            String
  emailBody          String    // The external email body they received
  contextNotes       String?   // Additional context/background
  customInstructions String?   // Custom instructions for AI

  // Processing status
  status             String    @default("pending") // pending, processing, completed, failed

  // AI Output (same structure as DraftResponse for consistency)
  internalReasoning  String?
  tags               String[]  @default([])
  category           String?
  reasoning          String?
  shouldDraft        Boolean   @default(true)
  draft              String?
  actionSteps        Json?
  orderInfo          Json?

  // Metadata
  processingTime     String?   // e.g., "2.3s"
  toolCallsMade      Int?      // Number of tool calls AI made
  error              String?   // Error message if failed

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime? // When processing finished
}

model Product {
  id                  String   @id @default(uuid())
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId         String

  // Basic Info
  name                String   // Product name (searchable by AI)
  sku                 String?  // SKU/Product code
  category            String?  // Product category
  status              String   @default("active") // active, discontinued, coming-soon

  // Product Details
  description         String?  @db.Text
  specifications      Json?    // Flexible JSON for custom specs
  features            String[] @default([])
  materials           String?
  dimensions          String?
  weight              String?
  colors              String[] @default([])
  sizes               String[] @default([])

  // Pricing & Availability
  price               String?
  msrp                String?
  availabilityStatus  String?  // in-stock, out-of-stock, preorder
  variants            Json?    // Array of {option, price, sku}

  // Shipping & Logistics
  shippingTime        String?  // "3-5 business days"
  shippingRestrictions String?
  handlingTime        String?
  shipsFrom           String?

  // Instructions & Support
  instructions        String?  @db.Text // Usage instructions
  careInstructions    String?  @db.Text
  warrantyInfo        String?  @db.Text
  returnPolicy        String?  @db.Text // Product-specific return policy

  // Additional Info
  faqs                Json?    // Array of {question, answer}
  relatedProducts     String[] @default([]) // Array of product IDs
  tags                String[] @default([])
  imageUrl            String?

  // AI Search
  aiSearchKeywords    String[] @default([]) // Keywords AI should search for

  // Metadata
  notes               String?  @db.Text // Internal notes for support agents
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([workspaceId])
  @@index([name])
  @@index([sku])
  @@index([status])
  @@index([category])
}

model OnboardingSection {
  id          String   @id @default(uuid())
  title       String   // Section title (e.g., "Getting Started", "Daily Workflow")
  slug        String   @unique // URL-friendly identifier
  content     String   @db.Text // Markdown/HTML content
  order       Int      @default(0) // Display order
  category    String   @default("tool-sop") // "tool-sop" or "general-sop"
  icon        String?  // Optional icon name
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([order])
}

model TrainingVideo {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  videoUrl    String   // YouTube URL, Vimeo, or direct video file URL
  thumbnailUrl String?
  duration    String?  // "5:30" format
  category    String?  // Optional grouping
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([order])
}
