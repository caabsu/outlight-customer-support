generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Workspace {
  id               String         @id @default(uuid())
  name             String
  gmailAccountEmail String        @unique
  googleClientId   String
  googleClientSecret String
  createdAt        DateTime       @default(now())
  customers        Customer[]
  conversations    Conversation[]
  oauthTokens      OAuthToken[]
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          String         @default("ADMIN")
  createdAt     DateTime       @default(now())
  conversations Conversation[] @relation("UserConversations")
}

model Customer {
  id            String         @id @default(uuid())
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId   String
  primaryEmail  String
  name          String?
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime?
  conversations Conversation[]

  @@unique([workspaceId, primaryEmail])
}

model Conversation {
  id                    String         @id @default(uuid())
  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId           String
  gmailThreadId         String
  subject               String?
  customer              Customer       @relation(fields: [customerId], references: [id])
  customerId            String
  status                String         @default("open")
  assignedUser          User?          @relation("UserConversations", fields: [assignedUserId], references: [id])
  assignedUserId        String?
  firstMessageAt        DateTime?
  lastMessageAt         DateTime?
  lastHistoryId         BigInt?
  unreadAgent           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  starred               Boolean        @default(false)
  archived              Boolean        @default(false)
  tags                  String[]       @default([])
  aiSummary             String?
  aiSummaryGeneratedAt  DateTime?
  messages              Message[]
  draftResponse         DraftResponse?

  @@unique([workspaceId, gmailThreadId])
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  gmailMessageId String       @unique
  direction      String
  fromEmail      String
  toEmails       Json         @default("[]")
  ccEmails       Json         @default("[]")
  sentAt         DateTime
  bodyHtml       String?
  bodyText       String?
  attachments    Json         @default("[]")
  replyToEmail   String?
  isRead         Boolean      @default(true)
}

model OAuthToken {
  id           String    @id @default(uuid())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId  String    @unique
  provider     String
  accountEmail String
  accessToken  String
  refreshToken String
  expiry       DateTime
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  tags      String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftResponse {
  id                 String       @id @default(uuid())
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId     String       @unique
  internalReasoning  String?
  tags               String[]     @default([])
  category           String?
  reasoning          String?
  shouldDraft        Boolean      @default(false)
  draft              String?
  actionSteps        Json?
  orderInfo          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model StandaloneDraft {
  id                 String    @id @default(uuid())

  // Input fields
  subject            String
  emailBody          String    // The external email body they received
  contextNotes       String?   // Additional context/background
  customInstructions String?   // Custom instructions for AI

  // Processing status
  status             String    @default("pending") // pending, processing, completed, failed

  // AI Output (same structure as DraftResponse for consistency)
  internalReasoning  String?
  tags               String[]  @default([])
  category           String?
  reasoning          String?
  shouldDraft        Boolean   @default(true)
  draft              String?
  actionSteps        Json?
  orderInfo          Json?

  // Metadata
  processingTime     String?   // e.g., "2.3s"
  toolCallsMade      Int?      // Number of tool calls AI made
  error              String?   // Error message if failed

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime? // When processing finished
}
