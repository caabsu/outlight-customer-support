generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          String         @default("ADMIN")
  createdAt     DateTime       @default(now())
  conversations Conversation[] @relation("UserConversations")
}

model Customer {
  id            String         @id @default(uuid())
  primaryEmail  String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime?
  conversations Conversation[]
}

model Conversation {
  id                    String         @id @default(uuid())
  gmailThreadId         String         @unique
  subject               String?
  customer              Customer       @relation(fields: [customerId], references: [id])
  customerId            String
  status                String         @default("open")
  assignedUser          User?          @relation("UserConversations", fields: [assignedUserId], references: [id])
  assignedUserId        String?
  firstMessageAt        DateTime?
  lastMessageAt         DateTime?
  lastHistoryId         BigInt?
  unreadAgent           Boolean        @default(true)
  createdAt             DateTime       @default(now())
  starred               Boolean        @default(false)
  archived              Boolean        @default(false)
  tags                  String[]       @default([])
  aiSummary             String?
  aiSummaryGeneratedAt  DateTime?
  messages              Message[]
  draftResponse         DraftResponse?
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  gmailMessageId String       @unique
  direction      String
  fromEmail      String
  toEmails       Json         @default("[]")
  ccEmails       Json         @default("[]")
  sentAt         DateTime
  bodyHtml       String?
  bodyText       String?
  attachments    Json         @default("[]")
  replyToEmail   String?
  isRead         Boolean      @default(true)
}

model OAuthToken {
  id           String   @id @default(uuid())
  provider     String
  accountEmail String   @unique
  accessToken  String
  refreshToken String
  expiry       DateTime
}

model KnowledgeBase {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?
  tags      String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftResponse {
  id                 String       @id @default(uuid())
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId     String       @unique
  internalReasoning  String?
  tags               String[]     @default([])
  category           String?
  reasoning          String?
  shouldDraft        Boolean      @default(false)
  draft              String?
  actionSteps        String?
  orderInfo          Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}
