{
    "name": "outlight-customer-support",
    "version": "1.0.1",
    "main": "index.js",
    "private": true,
    "scripts": {
        "dev": "ts-node apps/api/src/server.ts",
        "dev:web": "cd apps/web && npm run dev",
        "dev:all": "concurrently \"npm run dev\" \"npm run dev:web\" --names \"API,WEB\" --prefix-colors \"cyan,magenta\"",
        "build": "tsc && npx prisma generate",
        "build:web": "cd apps/web && npm install && npm run build",
        "start": "npx prisma migrate resolve --applied 20251021043907_add_tags_starred_archived_replyto || true && npx prisma migrate deploy && node dist/apps/api/src/server.js",
        "start:web": "cd apps/web && npm start",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/caabsu/outlight-customer-support.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/caabsu/outlight-customer-support/issues"
    },
    "homepage": "https://github.com/caabsu/outlight-customer-support#readme",
    "description": "",
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^24.9.1",
        "concurrently": "^9.2.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@prisma/client": "^6.17.1",
        "cors": "^2.8.5",
        "dayjs": "^1.11.18",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "googleapis": "^164.1.0",
        "openai": "^6.6.0",
        "pg": "^8.16.3",
        "prisma": "^6.17.1",
        "zod": "^4.1.12"
    }
}
