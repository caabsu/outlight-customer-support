# Database Configuration
# Get these from your Supabase project settings -> Database -> Connection String
# Use Connection Pooling string for DATABASE_URL (port 5432)
# Use Direct Connection string for DIRECT_URL
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google OAuth (for Gmail integration)
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add redirect URI: http://localhost:3001/oauth/google/callback
# 3. Enable Gmail API in Google Cloud Console
GOOGLE_CLIENT_ID=123456789-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123...
GOOGLE_REDIRECT_URI=http://localhost:3001/oauth/google/callback
GMAIL_ACCOUNT_EMAIL=your-support-email@gmail.com

# Shopify Admin API
# Get from: Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
# 1. Create custom app
# 2. Configure Admin API scopes: read_customers, write_customers, read_orders, write_orders, read_products
# 3. Install app and copy Admin API access token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_abc123...
SHOPIFY_API_VERSION=2024-01

# Shopify Store (for web app - used in frontend)
NEXT_PUBLIC_SHOPIFY_STORE=your-store.myshopify.com

# 17track API Configuration
# Get from: https://www.17track.net/en/api (Settings -> API Key)
# API Docs: https://asset.17track.net/api/document/v2_en/index.html
SEVENTEENTRACK_API_KEY=your-17track-api-key

# Server Configuration
PORT=3001
